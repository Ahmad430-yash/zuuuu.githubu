        </a>

        <a class="btn btn-secondary" href="#contact">
          Get In Touch
        </a>
      </div>
    </div>

    <div class="profile-card reveal">
      <div class="avatar">ZA</div>

      <h3>Zubair Ahmad</h3>

      <p>
        Business Management Student<br>
        South Korea
      </p>
    </div>

  </div>
</header>

<section id="about">
