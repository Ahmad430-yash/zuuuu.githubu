        </p>
      </div>

    </div>
  </div>
</section>

<section id="skills">
  <div class="container reveal">

    <h2 class="section-title">
      My <span>strengths.</span>
    </h2>

    <div class="skills">
      <span class="skill">Leadership</span>
      <span class="skill">Teamwork</span>
      <span class="skill">Communication</span>
